<UserControl x:Class="CardGame.WPF.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок / золото -->
            <RowDefinition Height="Auto"/>
            <!-- 5 карт -->
            <RowDefinition Height="Auto"/>
            <!-- 2 карты + 3 реликвии + удаление -->
            <RowDefinition Height="Auto"/>
            <!-- спейсер -->
            <RowDefinition Height="Auto"/>
            <!-- кнопка уйти -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="Shop" FontSize="32" Foreground="White"
                       FontWeight="Bold" Margin="0,0,40,0"/>
            <TextBlock x:Name="GoldText" FontSize="28" Foreground="Gold"/>
        </StackPanel>

        <!-- Верхний ряд: 5 карт -->
        <StackPanel Grid.Row="1" 
                    x:Name="TopCardsPanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="20,10">
        </StackPanel>

        <!-- Нижний ряд: 2 карты слева, 3 реликвии + удаление справа -->
        <Grid Grid.Row="2" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- 2 карты -->
                <ColumnDefinition Width="*"/>
                <!-- спейсер -->
                <ColumnDefinition Width="Auto"/>
                <!-- 3 реликвии -->
                <ColumnDefinition Width="Auto"/>
                <!-- удаление -->
            </Grid.ColumnDefinitions>

            <!-- 2 карты слева -->
            <StackPanel Grid.Column="0" 
                        x:Name="BottomCardsPanel"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
            </StackPanel>

            <!-- 3 реликвии -->
            <ItemsControl Grid.Column="2" x:Name="RelicsPanel"
                          VerticalAlignment="Top" Margin="0,0,20,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Удаление карты -->
            <Button Grid.Column="3" x:Name="RemoveCardButton"
                    Width="120" Height="160"
                    VerticalAlignment="Top"
                    Background="#3a3a5a" Foreground="White"
                    BorderBrush="#5a5a7a" BorderThickness="3"
                    Click="RemoveCard_Click"/>
        </Grid>

        <Button Grid.Row="4" Content="Leave Shop"
                Width="150" Height="40" Margin="20"
                HorizontalAlignment="Center"
                Background="#3a3a5a" Foreground="White"
                BorderBrush="#5a5a7a" BorderThickness="2"
                Click="Leave_Click"/>
    </Grid>
</UserControl>