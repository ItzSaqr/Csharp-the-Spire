<Window x:Class="CardGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">
    <Grid Background="#8c8c96">
        <Grid x:Name="CombatUI">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- информация -->

                    <RowDefinition Height="*"/>
                    <!-- поле боя -->

                    <RowDefinition Height="260"/>
                    <!-- рука -->

                    <RowDefinition Height="80"/>
                    <!-- кнопки -->
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                Grid.Column="0"
                Margin="20">

                    <TextBlock x:Name="HpText" FontSize="24"/>
                    <TextBlock x:Name="BlockText" FontSize="24"/>
                    <TextBlock x:Name="EnergyText" FontSize="24"/>

                </StackPanel>


                <StackPanel Grid.Row="0"
                Grid.Column="2"
                Margin="20"
                HorizontalAlignment="Center">

                    <TextBlock x:Name="EnemyNameText" 
                       FontSize="24"/>
                    <TextBlock x:Name="EnemyHpText" 
                       FontSize="24"/>
                    <TextBlock x:Name="EnemyBlockText" 
                       FontSize="24"/>
                    <TextBlock x:Name="EnemyIntentText" 
                       FontSize="18"
                       TextWrapping="Wrap"/>

                </StackPanel>

                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2">
                    <Image x:Name="BattleBackground" Source="..." Stretch="UniformToFill"/>

                    <!-- Игрок -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="250,0,0,100" Width="350">
                        <Image x:Name="PlayerSprite"
                            RenderTransformOrigin="0.5,0.5"
                            Source="/assets/sprites/player.png"
                            Stretch="Uniform"/>

                        <Grid Margin="0,8,0,0" Height="20">
                            <ProgressBar x:Name="PlayerHpBar"
                                Minimum="0" Maximum="80" Value="80"
                                Foreground="#c0392b"
                                Background="#2c2c3a"
                                BorderBrush="#1a1a2e"
                                BorderThickness="2"/>
                            <TextBlock x:Name="PlayerHpLabel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                IsHitTestVisible="False">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Враг -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,300,100" Width="350">
                        <Image x:Name="EnemySprite"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"/>

                        <Grid Margin="0,8,0,0" Height="20">
                            <ProgressBar x:Name="EnemyHpBar"
                                Minimum="0" Maximum="26" Value="26"
                                Foreground="#c0392b"
                                Background="#2c2c3a"
                                BorderBrush="#1a1a2e"
                                BorderThickness="2"/>
                            <TextBlock x:Name="EnemyHpLabel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                IsHitTestVisible="False">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Canvas x:Name="EffectsCanvas" IsHitTestVisible="False"/>
                </Grid>

                <ScrollViewer Grid.Row="2"
                  Grid.ColumnSpan="3"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="HandPanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Margin="20"/>

                </ScrollViewer>

                <Button x:Name="EndTurnButton" 
                Content="End Turn" 
                Width="100" 
                Height="40" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="20" 
                Grid.Row="3"
                Grid.Column="2"
                Click="EndTurn_Click">
                </Button>

                <StackPanel Grid.Row="3"
                Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Margin="20">

                    <Button Content="Draw" Width="100" Click="ViewDrawPile_Click"/>
                    <Button Content="Discard" Width="100" Margin="10,0,0,0" Click="ViewDiscardPile_Click"/>
                    <Button Content="Exhaust" Width="100" Margin="10,0,0,0" Click="ViewExhaustPile_Click"/>

                </StackPanel>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
               Text="Passives"
               FontSize="18"
               Margin="10"/>

                    <WrapPanel Grid.Row="1"
               x:Name="PlayerPassivesPanel"
               Margin="10"/>

                    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Effects"
                       FontSize="18"
                       Margin="10"/>

                            <WrapPanel x:Name="PlayerEffectsPanel"
                       Margin="10"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                       Text="Passives"
                       FontSize="18"
                       Margin="10"/>

                    <WrapPanel Grid.Row="1"
                       x:Name="EnemyPassivesPanel"
                       Margin="10"/>

                    <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Effects"
                               FontSize="18"
                               Margin="10"/>

                            <WrapPanel x:Name="EnemyEffectsPanel"
                               Margin="10"/>

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

                <Grid x:Name="PileOverlay"
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Visibility="Collapsed"
                Background="#AA000000"
                MouseLeftButtonDown="ClosePileOverlay_Click">

                    <Border Width="700"
                    Height="500"
                    Background="#222"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="BorderPile_Click">


                        <ScrollViewer>
                            <WrapPanel x:Name="PilePanel"/>
                        </ScrollViewer>

                    </Border>

                </Grid>

                <Grid x:Name="RewardOverlay"
                  Grid.Row="0"
                  Grid.RowSpan="4"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Visibility="Collapsed"
                  Background="#CC000000">

                    <Border Width="700"
                        Height="500"
                        Background="#1a1a2e"
                        CornerRadius="15"
                        BorderBrush="#4a4a6e"
                        BorderThickness="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                   Text="Rewards"
                                   FontSize="28"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="20,20,20,10"/>

                            <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="20">
                                <WrapPanel x:Name="RewardPanel"
                                       HorizontalAlignment="Center"/>
                            </ScrollViewer>

                            <Button Grid.Row="2"
                                x:Name="SkipRewardButton"
                                Content="Skip Reward"
                                Width="150"
                                Height="40"
                                Margin="20"
                                HorizontalAlignment="Center"
                                Background="#3a3a5a"
                                Foreground="White"
                                BorderBrush="#5a5a7a"
                                BorderThickness="2"
                                Click="SkipReward_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="CardChoiceOverlay"
                      Grid.Row="0"
                      Grid.RowSpan="4"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Visibility="Collapsed"
                      Background="#CC000000">

                    <Border Width="800"
                            Height="600"
                            Background="#1a1a2e"
                            CornerRadius="15"
                            BorderBrush="#4a4a6e"
                            BorderThickness="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Select a Card"
                                       FontSize="28"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="20,20,20,10"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="20">
                                <WrapPanel x:Name="CardChoicePanel"
                                           HorizontalAlignment="Center"/>
                            </ScrollViewer>

                            <Button Grid.Row="2"
                                Content="Cancel"
                                Width="120"
                                Height="40"
                                Margin="20"
                                HorizontalAlignment="Center"
                                Background="#3a3a5a"
                                Foreground="White"
                                BorderBrush="#5a5a7a"
                                BorderThickness="2"
                                Click="CancelCardChoice_Click"/>
                        </Grid>
                    </Border>
                </Grid>
                
                
            </Grid>
        </Grid>
        <Grid x:Name="MapUI" Visibility="Visible">
            <ContentControl x:Name="MapContent"/>
        </Grid>
        <Grid x:Name="RestUI" Visibility="Collapsed">
            <ContentControl x:Name="RestContent"/>
        </Grid>
        <Grid x:Name="TreasureUI" Visibility="Collapsed">
            <ContentControl x:Name="TreasureContent"/>
        </Grid>
    </Grid>
</Window>