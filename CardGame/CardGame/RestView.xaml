<UserControl x:Class="CardGame.RestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">

    <Grid Background="#1a1a2e">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Информация -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20" HorizontalAlignment="Center">
            <TextBlock x:Name="HpText" Foreground="White" FontSize="24" Margin="0,0,20,0"/>
            <TextBlock x:Name="GoldText" Foreground="Gold" FontSize="24"/>
        </StackPanel>

        <!-- Опции костра -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20">
            <WrapPanel x:Name="OptionsPanel" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Width="500">
            </WrapPanel>
        </ScrollViewer>

        <!-- Оверлей для выбора карты -->
        <Grid x:Name="CardSelectionOverlay"
              Grid.Row="0"
              Grid.RowSpan="4"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Visibility="Collapsed"
              Background="#CC000000"
              MouseLeftButtonDown="CloseCardSelection_Click">

            <Border Width="800"
                    Height="600"
                    Background="#1a1a2e"
                    CornerRadius="10"
                    BorderBrush="#4a4a6e"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="BorderCardSelection_Click">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0"
                               Text="Select a card to upgrade"
                               FontSize="28"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="20,20,20,10"/>

                    <!-- Список карт -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="20">
                        <WrapPanel x:Name="UpgradeCardsPanel"
                                   HorizontalAlignment="Center"/>
                    </ScrollViewer>

                    <!-- Кнопка отмены -->
                    <Button Grid.Row="2"
                            Content="Cancel"
                            Width="120"
                            Height="40"
                            Margin="20"
                            HorizontalAlignment="Center"
                            Background="#3a3a5a"
                            Foreground="White"
                            BorderBrush="#5a5a7a"
                            BorderThickness="2"
                            Click="CancelUpgrade_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>